<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CyberBreach" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/soc_primary</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">@color/soc_transparent_primary</item>
        <item name="colorOnPrimaryContainer">@color/soc_primary</item>

        <item name="colorSecondary">@color/soc_accent_cyan</item>
        <item name="colorOnSecondary">#000000</item>

        <item name="colorError">@color/soc_critical</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:colorBackground">@color/soc_background</item>
        <item name="colorOnBackground">@color/soc_text_primary</item>
        <item name="colorSurface">@color/soc_surface</item>
        <item name="colorOnSurface">@color/soc_text_primary</item>
        <item name="colorSurfaceVariant">@color/soc_surface</item>
        <item name="colorOnSurfaceVariant">@color/soc_text_secondary</item>
        <item name="colorOutline">@color/soc_surface_stroke</item>
        
        <item name="android:statusBarColor">@color/soc_background</item>
        <item name="android:navigationBarColor">@color/soc_surface</item>
    </style>

    <style name="CyberToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/soc_primary</item>
    </style>

    <style name="Theme.CyberBreach" parent="Base.Theme.CyberBreach" />
</resources>
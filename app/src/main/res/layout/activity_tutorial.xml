<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soc_background">

    <!-- Fake Top Bar -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="EMERGENCY BREACH DETECTED!"
        android:textColor="@color/soc_critical"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        
    <!-- Logs Area -->
    <LinearLayout
        android:id="@+id/llLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/bottomBar">
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TIME      SOURCE          EVENT" android:textColor="@color/soc_text_secondary" android:fontFamily="monospace" />
        
    </LinearLayout>

    <!-- Fake Tool Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/soc_surface"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <ImageView
            android:id="@+id/ivTool"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_search" />
            
        <TextView
            android:id="@+id/tvTool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Packet Analyzer"
            android:textColor="@color/soc_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Overlay Text -->
    <TextView
        android:id="@+id/tvOverlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E60F1923"
        android:padding="24dp"
        android:text="Welcome Agent. We have an active breach!"
        android:textColor="@color/soc_accent_cyan"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

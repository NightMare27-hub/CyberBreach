<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night theme is identical since CyberBreach is always dark -->
    <style name="Base.Theme.CyberBreach" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyber_primary</item>
        <item name="colorOnPrimary">@color/cyber_on_primary</item>
        <item name="colorPrimaryContainer">@color/cyber_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cyber_on_primary_container</item>

        <item name="colorSecondary">@color/cyber_secondary</item>
        <item name="colorOnSecondary">@color/cyber_on_secondary</item>
        <item name="colorSecondaryContainer">@color/cyber_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/cyber_on_secondary_container</item>

        <item name="colorError">@color/cyber_error</item>
        <item name="colorOnError">@color/cyber_on_error</item>
        <item name="colorErrorContainer">@color/cyber_error_container</item>
        <item name="colorOnErrorContainer">@color/cyber_on_error_container</item>

        <item name="android:colorBackground">@color/cyber_background</item>
        <item name="colorOnBackground">@color/cyber_on_background</item>
        <item name="colorSurface">@color/cyber_surface</item>
        <item name="colorOnSurface">@color/cyber_on_surface</item>
        <item name="colorSurfaceVariant">@color/cyber_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/cyber_on_surface_variant</item>
        <item name="colorOutline">@color/cyber_outline</item>
        <item name="colorOutlineVariant">@color/cyber_outline_variant</item>
        <item name="colorSurfaceInverse">@color/cyber_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/cyber_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/cyber_inverse_primary</item>
        <item name="colorSurfaceContainerLowest">@color/cyber_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/cyber_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/cyber_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/cyber_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/cyber_surface_container_highest</item>

        <item name="android:statusBarColor">@color/cyber_background</item>
        <item name="android:navigationBarColor">@color/cyber_surface_container</item>
